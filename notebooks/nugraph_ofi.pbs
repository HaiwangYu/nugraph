#!/bin/bash -l
#PBS -N Nugraph_DDP
#PBS -l select=4:ncpus=32:ngpus=4:mem=128gb
#PBS -l walltime=1:00:00
#PBS -q debug-scaling
#PBS -A neutrinoGPU::debug
#PBS -l filesystems=home:grand:eagle
#PBS -j oe
#PBS -o nugraph_debug_aws_ofi.log

set -euo pipefail

cd "${PBS_O_WORKDIR}"
echo "Starting job in $(pwd)"
echo "Job running on nodes:"; cat "$PBS_NODEFILE"

# --- Modules/conda ---
module use /soft/modulefiles
module load conda/2024-04-29
conda activate /lus/eagle/projects/neutrinoGPU/abhat/conda/envs/nugraph-a
module load cudatoolkit-standalone
module load libfabric/1.22.0     # cxi provider
export NUGRAPH_REPO=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/nugraph
export PYTHONPATH="${NUGRAPH_REPO}/nugraph:${NUGRAPH_REPO}:${PYTHONPATH:-}"
echo "Using NUGRAPH_REPO=${NUGRAPH_REPO}"
echo "PYTHONPATH=${PYTHONPATH}"


# --- aws-ofi-nccl (v1.9.1) and hwloc v2 shim ---
export AWS_OFI_NCCL=/soft/libraries/aws-ofi-nccl/v1.9.1-aws-libfabric-1.22.0
export HWLOC2_SHIM="$HOME/hwloc2-shim"   # contains libhwloc.so.0 -> /usr/lib64/libhwloc.so.15

# Put shim FIRST, then plugin dir
export LD_LIBRARY_PATH="${HWLOC2_SHIM}:${AWS_OFI_NCCL}/lib:${LD_LIBRARY_PATH:-}"
export NCCL_PLUGIN_PATH="${AWS_OFI_NCCL}/lib"
export NCCL_PLUGIN_DISABLE=0
unset NCCL_NET   # let NCCL auto-detect the OFI plugin


# --- Tell Cray MPICH NOT to use its GPU path (we use NCCL instead) ---
export MPICH_GPU_SUPPORT_ENABLED=0
export MPICH_OFI_NIC_POLICY=NUMA   # good practice on Polaris; optional but recommended


# --- NCCL + Libfabric/CXI on Polaris ---
export FI_PROVIDER=cxi
export FI_LOG_LEVEL=info
export NCCL_DEBUG=INFO
export NCCL_DEBUG_SUBSYS=INIT,NET
export NCCL_IB_DISABLE=1
export NCCL_COLLNET_ENABLE=0
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1
export NCCL_OFI_LOG_LEVEL=INFO

# Loud & clear failures / sync kernels
export PYTHONFAULTHANDLER=1
# export CUDA_LAUNCH_BLOCKING=1
# export TORCH_DISTRIBUTED_DEBUG=DETAIL

# Optional: avoid WANDB network during debugging
# export WANDB_MODE=offline

# --- Misc runtime ---
export OMP_NUM_THREADS=1
export HDF5_USE_FILE_LOCKING=FALSE

# --- Rendezvous for torch.distributed ---
export MASTER_ADDR="$(head -n1 "${PBS_NODEFILE}")"
export MASTER_PORT="${MASTER_PORT:-29500}"

# --- Dataset path; export so --envall propagates ---
export DATA="/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/23334072_3d_ppedges.h5"
ls -lh "$DATA" || { echo "DATA file missing"; exit 1; }

NODES="${PBS_NNODES:-2}"
GPUS_PER_NODE=4
WORLD_SIZE=$(( NODES * GPUS_PER_NODE ))
echo "NODES=${NODES} GPUS_PER_NODE=${GPUS_PER_NODE} WORLD_SIZE=${WORLD_SIZE}"
echo "MASTER_ADDR=${MASTER_ADDR} MASTER_PORT=${MASTER_PORT}"
echo "PYTHONPATH=${PYTHONPATH:-}"

# python - <<'PY'

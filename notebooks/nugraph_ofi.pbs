#!/bin/bash -l
#PBS -N Nugraph_DDP
#PBS -l select=4:ncpus=32:ngpus=4:mem=128gb
#PBS -l walltime=1:00:00
#PBS -q debug-scaling
#PBS -A neutrinoGPU::debug
#PBS -l filesystems=home:grand:eagle
#PBS -j oe
#PBS -o nugraph_debug_socket.log

set -euo pipefail

cd "${PBS_O_WORKDIR}"
echo "Starting job in $(pwd)"
echo "Raw node list from PBS:"
cat "${PBS_NODEFILE}"

module use /soft/modulefiles
module load conda/2024-04-29
conda activate /lus/eagle/projects/neutrinoGPU/abhat/conda/envs/nugraph-a
module load cudatoolkit-standalone
module load libfabric/1.22.0

export NUGRAPH_REPO=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/nugraph
export PYTHONPATH="${NUGRAPH_REPO}/nugraph:${NUGRAPH_REPO}:${PYTHONPATH:-}"

export MPICH_GPU_SUPPORT_ENABLED=1
export MPICH_OFI_NIC_POLICY=NUMA

# NCCL fallback to sockets
export NCCL_IB_DISABLE=1
export NCCL_NET=Socket
export NCCL_NET_PLUGIN=none
export NCCL_SOCKET_IFNAME=bond0
export NCCL_COLLNET_ENABLE=0
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1
export NCCL_DEBUG=INFO
export NCCL_DEBUG_SUBSYS=INIT,NET

export FI_PROVIDER=sockets
export FI_LOG_LEVEL=info

export PYTHONFAULTHANDLER=1
export OMP_NUM_THREADS=1
export HDF5_USE_FILE_LOCKING=FALSE

export DATA=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/23334072_3d_ppedges.h5
ls -lh "${DATA}" || exit 1

# Build a unique hostfile so mpiexec really launches 4 ranks per node
HOSTFILE="$(mktemp "${PBS_O_WORKDIR}/hosts.${PBS_JOBID}.XXXX")"
sort -u "${PBS_NODEFILE}" > "${HOSTFILE}"
echo "Clean host list:"
cat "${HOSTFILE}"

NODES=$(wc -l < "${HOSTFILE}")
GPUS_PER_NODE=4
WORLD_SIZE=$(( NODES * GPUS_PER_NODE ))
export MASTER_ADDR="$(head -n1 "${HOSTFILE}")"
export MASTER_PORT="${MASTER_PORT:-29500}"

echo "NODES=${NODES} GPUS_PER_NODE=${GPUS_PER_NODE} WORLD_SIZE=${WORLD_SIZE}"
echo "MASTER_ADDR=${MASTER_ADDR} MASTER_PORT=${MASTER_PORT}"

LOGDIR=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/nugraph/notebooks/log
RUN_NAME=nug4_edgeloss_lam0p5_pw10_n32_hf256_nf64_it7_scw10_ppedges
CKPT_PATH="${LOGDIR}/${RUN_NAME}/checkpoints/last.ckpt"
[ -f "${CKPT_PATH}" ] || CKPT_PATH=""

mpiexec -hostfile "${HOSTFILE}" -n "${WORLD_SIZE}" -ppn "${GPUS_PER_NODE}" --envall \
  python -u train.py \
    --model nugraph4 \
    --data-path "${DATA}" \
    --log-dir "${LOGDIR}" \
    --run-name "${RUN_NAME}" \
    --max-epochs 80 \
    --num-workers 0 \
    --gpus-per-node "${GPUS_PER_NODE}" \
    --learning-rate 1e-4 \
    --hit-features 256 \
    --semantic-class-weight 10.0 1.0 \
    --num-iters 7 \
    --nexus-features 64 \
    --interaction-features 32 \
    --in-features 8 \
    --min-nu-hits 0 \
    --shuffle weighted \
    --balance-frac 0.10 \
    --edge-hidden-dim 32 \
    --embed-dim 64 \
    --lambda-edge 0.5 \
    --edge-pos-weight 10.0 \
    --batch-size 32 \
    ${CKPT_PATH:+--resume-from "${CKPT_PATH}"}

# Optional: keep the hostfile for debugging; otherwise uncomment the next line
# rm -f "${HOSTFILE}"

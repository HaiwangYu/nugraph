# mpiexec -l -n "${WORLD_SIZE}" --ppn "${GPUS_PER_NODE}" --envall python nccl_smoke.py
# echo "=== end smoke test ==="

# --- Training (short) ---
LOGDIR=/lus/eagle/projects/neutrinoGPU/abhat/sbnd/clustering/nugraph/notebooks/log
RUN_NAME="nug4_edgeloss_lam0p5_pw10_n32_hf256_nf64_it7_scw10_ppedges"

# --- DEFINE THE CHECKPOINT PATH ---
CKPT_PATH="${LOGDIR}/${RUN_NAME}/checkpoints/last.ckpt"
echo "Attempting to resume training from: ${CKPT_PATH}"


# Check if the checkpoint file actually exists before trying to resume
if [ ! -f "${CKPT_PATH}" ]; then
    echo "WARNING: Checkpoint file not found at ${CKPT_PATH}. Starting a new run."
    CKPT_PATH="" # <-- SET TO AN EMPTY STRING, NOT "None"
fi

mpiexec -l -n "${WORLD_SIZE}" --ppn "${GPUS_PER_NODE}" --envall \
  python -u ./train.py \
    --model nugraph4 \
    --data-path "${DATA}" \
    --log-dir "${LOGDIR}" \
    --run-name "${RUN_NAME}" \
    --max-epochs 80 \
    --num-workers 0 \
    --gpus-per-node "${GPUS_PER_NODE}" \
    --learning-rate 1e-4 \
    --hit-features 256 \
    --semantic-class-weight 10.0 1.0 \
    --num-iters 7 \
    --nexus-features 64 \
    --interaction-features 32 \
    --in-features 8 \
    --min-nu-hits 0 \
    --shuffle weighted \
    --balance-frac 0.10 \
    --edge-hidden-dim 32 \
    --embed-dim 64 \
    --lambda-edge 0.5 \
    --edge-pos-weight 10.0 \
    --batch-size 1 \
    ${CKPT_PATH:+--resume-from "$CKPT_PATH"}